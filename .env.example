# Environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in real values for your
# machine. `.env` and `.env.local` are git-ignored — never commit secrets.

# Database connection string used by Prisma.
#
# Local development (default): file-based SQLite, zero setup.
# The path is resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# PostgreSQL alternative (uncomment and set the datasource provider to
# "postgresql" in prisma/schema.prisma to use it):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coffeeshop?schema=public"

# The admin portal runs on this port (customer storefront stays on 3000).
# `npm run dev:all` starts both; proxy.ts routes requests by port.
ADMIN_PORT="3001"

# Brute-force guard for POST /api/auth/login: max attempts per IP per 5 min.
LOGIN_RATE_LIMIT="10"
